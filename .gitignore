# ---- macOS ----
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# ---- Xcode: user-specific state ----
xcuserdata/
*.xcuserstate
*.xcuserdatad/
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# ---- Xcode: build products ----
build/
DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
*.app
*.xcarchive

# ---- Swift Package Manager ----
.build/
.swiftpm/
Packages/
Package.pins
Package.resolved.bak
# NOTE: Package.resolved is intentionally committed to pin AMSMB2 & transitive deps.
#       Xcode stores it at *.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcworkspace/xcuserdata/

# ---- Signing / secrets (never commit) ----
*.mobileprovision
*.provisionprofile
*.p12
*.cer
*.certSigningRequest
Secrets.xcconfig
*.local.xcconfig

# ---- Dependency managers we don't use, but guard anyway ----
Pods/
*.xcworkspace/contents.xcworkspacedata.bak
Carthage/Build/

# ---- Test / coverage output ----
*.xcresult
TestResults/
coverage/
*.profraw
*.profdata

# ---- Editors / tooling ----
.idea/
*.swp
*~
.vscode/
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output
